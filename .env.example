# ─── Mapbox (client-side maps + location search) ───────────────────────────
# Public token (pk.*). Create at https://account.mapbox.com/access-tokens/ and
# RESTRICT it by URL (your domain + http://localhost:5173). Copy this file to
# .env.local and paste your token.
VITE_MAPBOX_TOKEN=pk.your_token_here

# ─── AI chat (server-side, provider-agnostic) ──────────────────────────────
# The in-app chat proxies through the Node server (npm run server) using the
# OpenAI-compatible /chat/completions format — so ANY of these providers works.
# Uncomment ONE preset and set the model/key. The key stays server-side.
#
# OpenRouter — one key, any model (Claude, GPT, Gemini, Llama). Recommended.
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_API_KEY=sk-or-...
#   AI_MODEL=anthropic/claude-opus-4-8       # or openai/gpt-4o, google/gemini-2.0-flash, etc.
#
# OpenAI direct
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_API_KEY=sk-...
#   AI_MODEL=gpt-4o-mini
#
# Ollama (local, free, offline — no key needed)
#   Use 127.0.0.1, not localhost — Node's fetch may resolve localhost to IPv6
#   and hang if Ollama is bound to IPv4 only.
#   AI_BASE_URL=http://127.0.0.1:11434/v1
#   AI_MODEL=llama3.1
#
# Leave AI_BASE_URL/AI_MODEL unset to disable the chat (the widget hides itself).
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Port the Node server listens on (dev proxy + production). Default 8787.
PORT=8787
